# Copy this file to .env in the repository root, then replace the example passwords and secret.
DB_NAME=chat_app
DB_USERNAME=chatapp
DB_PASSWORD=replace_with_a_strong_database_password
DB_ROOT_PASSWORD=replace_with_a_different_strong_root_password
DB_SSL_MODE=PREFERRED
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
JWT_EXPIRATION=86400000

# Set this to the exact browser origin used to open the deployed frontend.
# Examples: https://chat.example.com or http://203.0.113.10
CHAT_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
FRONTEND_PORT=80
JPA_SHOW_SQL=false
